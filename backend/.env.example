# --- App ---
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 15+, pgvector) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sotonghaeyo

# --- Redis (Celery broker / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=
# 분류(F1)는 빠르고 저렴한 모델, 답변 초안(F4)은 더 강한 모델 권장.
# ⚠️ 모델 ID에 날짜 접미사를 붙이지 말 것(404 → 조용히 fallback).
AI_CLASSIFY_MODEL=claude-haiku-4-5
AI_DRAFT_MODEL=claude-sonnet-5

# --- 자동 응대 게이트 ---
# 이 신뢰도 미만이면 챗봇에 맡기지 않고 교사에게 보낸다. 오분류 비용이 비대칭이라
# 기본값을 높게 잡았다(services/ai/gate.py).
# 주의: 규칙 기반 fallback 분류기는 0.4 를 반환하므로 키가 없으면 자동 응대가 발생하지
# 않는다(의도된 동작). 데모에서 자동 응대를 보여줘야 하면 0.3 으로 낮춘다.
AUTO_ANSWER_MIN_CONFIDENCE=0.7

# --- 민원 접수 유량 제한 ---
# 접수 API는 인증이 없어서(학부모 로그인 강제 안 함) 유량 제한이 유일한 방어선이다.
# 분당 한도는 '사람이 넘길 수 없는 수준'으로만 잡아 스크립트를 걸러낸다.
# 시간당 한도를 크게 둔 이유: 익명 접수는 IP로 세는데 같은 학교 와이파이·통신사 NAT
# 뒤의 학부모들이 IP를 공유한다. 사건이 터져 여러 학부모가 동시에 접수할 때
# 정당한 민원이 서로를 막으면 안 된다. 로그인한 학부모는 사용자 id로 센다.
RATE_LIMIT_INTAKE_PER_MINUTE=5
RATE_LIMIT_INTAKE_PER_HOUR=100
RATE_LIMIT_SCHOOL_LOOKUP_PER_MINUTE=30
RATE_LIMIT_GUEST_LOOKUP_PER_MINUTE=20
# 비회원 조회: 비밀번호 N회 틀리면 M분 잠금 (0 이면 잠금 끔)
GUEST_LOOKUP_MAX_FAILURES=10
GUEST_LOOKUP_LOCK_MINUTES=10

# 프록시(로드밸런서·리버스 프록시) 뒤에 배포할 때만 true.
# 켜면 X-Forwarded-For를 클라이언트 IP로 신뢰한다 — 프록시가 없는데 켜면
# 공격자가 헤더를 위조해 한도를 무한히 우회할 수 있다.
TRUST_PROXY_HEADERS=false

# --- AI 임베딩 (F5 유사 사례 RAG) ---
# OpenAI 호환 /v1/embeddings 엔드포인트. 비워두면 결정론적 해싱 임베딩으로 동작.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small

# --- STT (F7 녹음 대화록 변환) ---
# CLOVA Speech Long Sentence 호출 정보. 비워두면 변환 태스크가 실패로 남는다.
CLOVA_STT_URL=
CLOVA_STT_SECRET=
