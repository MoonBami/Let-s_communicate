# --- App ---
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 15+, pgvector) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sotonghaeyo

# --- Redis (Celery broker / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=
# 분류(F1)는 빠르고 저렴한 모델, 답변 초안(F4)은 더 강한 모델 권장
AI_CLASSIFY_MODEL=claude-haiku-4-5-20251001
AI_DRAFT_MODEL=claude-sonnet-5

# --- 자동 응대 게이트 ---
# 이 신뢰도 미만이면 챗봇에 맡기지 않고 교사에게 보낸다. 오분류 비용이 비대칭이라
# 기본값을 높게 잡았다(services/ai/gate.py).
# 주의: 규칙 기반 fallback 분류기는 0.4 를 반환하므로 키가 없으면 자동 응대가 발생하지
# 않는다(의도된 동작). 데모에서 자동 응대를 보여줘야 하면 0.3 으로 낮춘다.
AUTO_ANSWER_MIN_CONFIDENCE=0.7

# --- AI 임베딩 (F5 유사 사례 RAG) ---
# OpenAI 호환 /v1/embeddings 엔드포인트. 비워두면 결정론적 해싱 임베딩으로 동작.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small

# --- STT (F7 녹음 대화록 변환) ---
# CLOVA Speech Long Sentence 호출 정보. 비워두면 변환 태스크가 실패로 남는다.
CLOVA_STT_URL=
CLOVA_STT_SECRET=
